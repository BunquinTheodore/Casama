{
  "name": "remotion",
  "version": "1.0.0",
  "description": "Data Science explorer video for group Theoraux, drawn from findings.json and series.json",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.546",
    "@remotion/fonts": "4.0.546",
    "@remotion/media": "4.0.546",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.546"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.546",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "10.15.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "sync": "node scripts/sync-data.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "sfx": "node scripts/sfx-track.mjs",
    "sound": "node scripts/mix-sound.mjs",
    "check": "node check.mjs",
    "render:video": "node scripts/sync-data.mjs && remotion render Explorer out/theoraux-data-science.mp4",
    "render:final": "node scripts/sync-data.mjs && node scripts/render-final.mjs"
  },
  "allowScripts": {
    "esbuild": false
  }
}
